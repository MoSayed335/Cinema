@model CinemaDeteils

@{
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="container">
    <h2 class="mb-4">Edit Cinema</h2>

    <form asp-area="Admin"
          asp-controller="Cinema"
          asp-action="Edit"
          method="post"
          enctype="multipart/form-data">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="CinemaId" />

        <div class="mb-3">
            <label class="form-label">Cinema Name</label>
            <input asp-for="Name" class="form-control" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label class="form-label">Cinema Image</label>
            <input type="file" name="Image" class="form-control" />
        </div>

        <div class="mb-3">
            <label class="form-label">Location</label>
            <input asp-for="Location" class="form-control" />
        </div>

        <div class="form-check mb-3">
            <input asp-for="Status" class="form-check-input" />
            <label class="form-check-label">Active</label>
        </div>

        <button type="submit" class="btn btn-primary">Update</button>
        <a asp-action="Index" class="btn btn-secondary">Back</a>
    </form>
</div>
