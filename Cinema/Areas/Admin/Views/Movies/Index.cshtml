@model  IEnumerable<Movie>
@{
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
}
<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Movies</h2>
        <a asp-area="Admin"
           asp-controller="Movies"
           asp-action="Create"
           class="btn btn-success">
            + Add Movie
        </a>
    </div>
<div class="table-responsive scrollbar">
    <table class="table">
        <thead>
            <tr>
                    <th scope="col">Image</th>
                    <th scope="col">Name</th>
                    <th scope="col">Cinema</th>
                    <th scope="col">Category</th>
                    <th scope="col">Price</th>
                    <th scope="col">Date</th>
                    <th scope="col">Status</th>
                <th class="text-end" scope="col">Actions</th>
            </tr>
        </thead>
        <tbody>
           @foreach(var item in Model)
                {
                    <tr>
                        <td>
                            <img src="~/img/Movie/@item.MainImg"
                                 width="70" height="90"
                                 class="rounded" />
                        </td>
                        <td>@item.Name</td>
                        <td>@item.Cinema?.Name</td>
                        <td>@item.Category?.Name</td>
                        <td>@item.Price EGP</td>
                        <td>@item.DateTime.ToString("dd/MM/yyyy HH:mm")</td>
                        <td>
                            @if (item.Status)
                            {
                                <span class="badge bg-success">Active</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">Inactive</span>
                            }
                            </td>
                        <td class="text-end">
                            @* <div>
                                <button class="btn btn-link p-0" type="button" data-bs-toggle="tooltip" data-bs-placement="top" title="Edit"><span class="text-500 fas fa-edit"></span></button>
                                <button class="btn btn-link p-0 ms-2" type="button" data-bs-toggle="tooltip" data-bs-placement="top" title="Delete"><span class="text-500 fas fa-trash-alt"></span></button>
                            </div> *@
                            <div>
                                <a asp-action="Edit"
                                   asp-route-id="@item.MovieId"
                                   class="btn btn-link p-0"
                                   data-bs-toggle="tooltip"
                                   data-bs-placement="top"
                                   title="Edit">
                                    <span class="text-500 fas fa-edit"></span>
                                </a>

                                <a asp-action="Delete"
                                   asp-route-id="@item.MovieId"
                                   class="btn btn-link p-0 ms-2 btn-delete"
                                   data-bs-toggle="tooltip"
                                   data-bs-placement="top"
                                   title="Delete"
                                   onclick="">
                                    <span class="text-500 fas fa-trash-alt"></span>
                                </a>
                            </div>
                        </td>
                    </tr>
                }
        </tbody>
    </table>
</div>
</div>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            document.querySelectorAll(".btn-delete").forEach(button => {
                button.addEventListener("click", function (e) {
                    e.preventDefault();
                    const url = this.getAttribute("href");
                      Swal.fire({
                       title: "Are you sure?",
                       text: "You won't be able to revert this!",
                       icon: "warning",
                      showCancelButton: true,
                      confirmButtonColor: "#3085d6",
                      cancelButtonColor: "#d33",
                      confirmButtonText: "Yes, delete it!"
                      }).then((result) => {
                     if (result.isConfirmed) {
                        Swal.fire({
                       title: "Deleted!",
                       text: "Your file has been deleted.",
                        icon: "success"
                      });
                      window.location.href = url;
                   }
                  });
                });
            });
        });
    </script>

