@model CinemaDeteils
@{
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
}

<section class="container py-5">
    <div class="row align-items-center">

        <div class="col-md-4">
            <img src="~/img/Cinema/@Model.Image"
                 class="img-fluid rounded shadow-lg" />
        </div>

        <div class="col-md-8 text-light">
            <h1 class="text-warning fw-bold">@Model.Name</h1>
            <p class="mt-3 text-muted">@Model.Location</p>
        </div>
    </div>
</section>

<section class="container mt-5">
    <div class="row g-4">
        @foreach (var movie in Model.Movies)
        {
            <div class="col-12 col-sm-6 col-md-4 col-lg-3">

                <a asp-area="Admin"
                   asp-controller="Home"
                   asp-action="Edit"
                   asp-route-id="@movie.MovieId"
                   class="text-decoration-none">
                    <div class="card bg-dark text-white h-100 border-secondary shadow">

                        <img src="~/img/Movie/@movie.MainImg"
                             class="card-img-top"
                             alt="@movie.Name"
                             style="height: 300px; object-fit: cover;" />

                        <div class="card-body text-center">
                            <h6 class="card-title text-warning m-0">@movie.Name</h6>
                        </div>

                    </div>
                </a>

            </div>
        }
    </div>
</section>