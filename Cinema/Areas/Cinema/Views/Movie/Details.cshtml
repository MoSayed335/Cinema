@model Movie
@{
    Layout = "~/Areas/Cinema/Views/Shared/_LayoutCinema.cshtml";
}

<section class="container py-5">
    <div class="row align-items-center">

        <div class="col-md-4">
            <img src="~/img/Movie/@Model.MainImg"
                 class="img-fluid rounded shadow-lg" />
        </div>

        <div class="col-md-8 text-light">
            <h1 class="text-warning fw-bold">@Model.Name</h1>
            <p class="mt-3 text-muted">@Model.Description</p>

            <ul class="list-unstyled mt-4">
                <li><strong>🎥 Cinema:</strong> @Model.Cinema.Name</li>
                <li><strong>📂 Category:</strong> @Model.Category.Name</li>
                <li><strong>🕒 Time:</strong> @Model.DateTime.ToString("dd MMM yyyy - hh:mm tt")</li>
            </ul>

            <h3 class="mt-4 text-success">@Model.Price EGP</h3>

            <a
               class="btn btn-warning btn-lg mt-4">
                🎟️ Book Ticket
            </a>
        </div>
    </div>
</section>
<hr class="my-5" />

<h3 class="text-warning mb-4">🎭 Cast</h3>

<div class="row g-4">
    @foreach (var actor in Model.MovieActors)
    {
        <div class="col-lg-2 col-md-3 col-sm-4 col-6 text-center">
            <div class="actor-card">
                <img src="~/img/Actors/@actor.Actor.Image"
                     class="actor-img" />

                <h6 class="mt-2">@actor.Actor.Name</h6>
            </div>
        </div>
    }
</div>

