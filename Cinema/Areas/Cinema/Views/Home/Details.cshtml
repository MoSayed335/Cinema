@model CinemaMoviesVM
@{
    Layout = "~/Areas/Cinema/Views/Shared/_LayoutCinema.cshtml";
}

<section class="cinema-section">
    <h2 class="section-title">🎬 @Model.CinemaName Movies</h2>

    <div class="cinema-grid">
        @foreach (var movie in Model.Movies)
        {
            <a asp-area="Cinema"
               asp-controller="Movie"
               asp-action="Details"
               asp-route-id="@movie.MovieId"
               class="cinema-card">

                <div class="cinema-img-box">
                    <img src="~/img/Movie/@movie.MainImg" />
                    <div class="overlay"></div>
                </div>

                <div class="cinema-name">@movie.Name</div>
            </a>
        }
    </div>
</section>
