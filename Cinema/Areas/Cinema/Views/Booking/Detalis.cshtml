@model Booking

@{
    ViewData["Title"] = "Booking Details";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a asp-action="Index">My Bookings</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Details</li>
                </ol>
            </nav>

            <div class="card shadow-lg border-0 overflow-hidden">
                <div class="row g-0">
                    <div class="col-md-4 bg-primary text-white d-flex flex-column justify-content-center align-items-center p-4">
                        <i class="bi bi-ticket-perforated" style="font-size: 4rem;"></i>
                        <h4 class="mt-3">Ticket ID</h4>
                        <span class="badge bg-light text-primary fs-5">#@Model.Id</span>
                        <hr class="w-75">
                        <p class="text-center small">Please show this ticket at the cinema entrance.</p>
                    </div>

                    <div class="col-md-8">
                        <div class="card-body p-4">
                            <div class="d-flex justify-content-between align-items-start mb-3">
                                <h2 class="card-title text-dark fw-bold">@Model.Movie.Name</h2>
                                <span class="badge @(Model.SeatType == SeatType.VIP ? "bg-warning text-dark" : "bg-info text-white") p-2">
                                    @Model.SeatType Edition
                                </span>
                            </div>

                            <div class="row mt-4">
                                <div class="col-6 mb-3">
                                    <label class="text-muted d-block small mb-1">Customer Name</label>
                                    <span class="fw-semibold">@User.Identity.Name</span>
                                </div>
                                <div class="col-6 mb-3">
                                    <label class="text-muted d-block small mb-1">Show Time</label>
                                    <span class="fw-semibold text-primary"><i class="bi bi-calendar3"></i> @Model.ShowTime.ToString("dd MMM yyyy, hh:mm tt")</span>
                                </div>
                                <div class="col-6 mb-3">
                                    <label class="text-muted d-block small mb-1">Tickets Count</label>
                                    <span class="fw-semibold">@Model.NumbetOFTikets Tickets</span>
                                </div>
                                <div class="col-6 mb-3">
                                    <label class="text-muted d-block small mb-1">Total Amount</label>
                                    <span class="fw-bold text-success fs-5">$@Model.TotalPrice.ToString("N2")</span>
                                </div>
                                <div class="col-12">
                                    <label class="text-muted d-block small mb-1">Booking Date</label>
                                    <span class="text-muted small">Purchased on @Model.BookingDate.ToString("f")</span>
                                </div>
                                <div class="d-grid gap-2 mt-4">
                                    <a asp-action="Payment" asp-controller="Booking" asp-route-bookingId="@Model.Id"
                                       class="btn btn-warning btn-lg fw-bold shadow">
                                        <i class="bi bi-credit-card-2-front"></i> Pay Now (@Model.TotalPrice.ToString("C"))
                                    </a>
                                </div>
                            </div>

                            <hr class="my-4">

                            <div class="d-flex gap-2">
                                <button onclick="window.print()" class="btn btn-outline-dark">
                                    <i class="bi bi-printer"></i> Print Ticket
                                </button>
                                <a asp-action="Index" class="btn btn-secondary">Back to List</a>
                                <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-danger ms-auto">Cancel Booking</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    <partial name="_NotificationPartial" />
}